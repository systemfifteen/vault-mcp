# Copy to .env for local development. Never commit .env.
# Production value lives in 1Password (trezor kocka, položka vault-mcp) and is set by secret-rotation.
MCP_TOKEN=
# Vault inside the container (read-only bind mount)
VAULT_DIR=/vault
# Comma-separated folders/notes hidden from the tools
VAULT_EXCLUDE=Medrio
PUBLIC_HOST=vault.system15.win
LOG_LEVEL=INFO
